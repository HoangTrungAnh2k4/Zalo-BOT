# Token lấy ở https://bot.zaloplatforms.com (dạng 123456789:abc...)
ZALO_BOT_TOKEN=

# Chỉ cần khi chạy webhook (production). URL phải là https và kết thúc bằng /webhook
WEBHOOK_URL=https://your-domain.com/webhook
# Chuỗi bí mật 8-256 ký tự, tự đặt (VD: openssl rand -hex 24)
WEBHOOK_SECRET=

# SQLite mặc định. Dùng Postgres: pip install "psycopg[binary]" rồi đặt
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/bot.db

LOG_LEVEL=INFO
# Thời gian chờ mỗi lần getUpdates (giây) khi chạy polling
POLL_TIMEOUT=30
# Chỉ đổi nếu Zalo đổi địa chỉ API
# ZALO_API_BASE=https://bot-api.zaloplatforms.com
